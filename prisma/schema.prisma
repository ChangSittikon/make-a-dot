generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================================
// PILLAR 1: CORE MATCHMAKING (เดิม)
// ============================================================

model Industry {
  id    String  @id @default(cuid())
  name  String
  icon  String? // FontAwesome class name e.g. "fa-solid fa-music"
  order Int     @default(0)

  // Platform Fee สำหรับวงการนี้ (basis points: 500 = 5.00%)
  macroFeePercentage Int @default(500)

  // AI Control Panel: คำสั่งพิเศษสำหรับ AI ของวงการนี้
  aiPromptDirective String?
  aiNodeCount       Int     @default(5)
  aiToneLevel       Int     @default(2)
  aiSmartChoices    String? // JSON array

  // Relations
  nodes          Node[]
  domainDirector DomainDirector?
  projects       Project[]
  occupations    Occupation[]    // Cascading taxonomy: Industry → Occupation → SkillTag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Node {
  id         String   @id @default(cuid())
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  type       String   @default("QUESTION") // START, QUESTION, RESULT
  question   String?
  order      Int      @default(0)

  options  Option[] @relation("NodeOptions")
  incoming Option[] @relation("TargetNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id     String  @id @default(cuid())
  nodeId String
  node   Node    @relation("NodeOptions", fields: [nodeId], references: [id], onDelete: Cascade)
  label  String
  icon   String? // FontAwesome class name
  order  Int     @default(0)

  // Algorithm & Variables Mapping (JSON String: e.g. {"budget": 10, "sweat": 5, "timeline": -5})
  vectorWeight String? 

  targetNodeId String?
  targetNode   Node?   @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: SetNull)
}

// ============================================================
// USER & ROLE SYSTEM
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  avatarUrl     String?

  // RBAC: Role-Based Access Control
  // Values: USER | PROFESSIONAL | GUARANTOR | DIRECTOR | ADMIN
  role         String  @default("USER")
  isVerified   Boolean @default(false)
  licenseData  String? // JSON: {"licenseNo": "...", "issuedBy": "...", "expiresAt": "..."}

  phone        String?
  bankAccount  String?
  cryptoWallet String?
  trustScore   Int     @default(0)

  // Auth.js Relations
  accounts Account[]
  sessions Session[]

  // Core Relations
  directorProfile      DomainDirector?
  projectsOwned        Project[]             @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  canvasProposals      CollaborationCanvas[] @relation("CanvasProposer")
  guaranteesGiven      GuarantorNode[]       @relation("GuarantorUser")
  endorsementsReceived Endorsement[]         @relation("EndorsedUser")
  equitySplits         EquitySplitMember[]

  // Bounty Protocol Relations
  problemsRequested ProblemNode[] @relation("Requester") // ปัญหาที่ user นี้ตั้งค่าหัว
  problemsSolved    ProblemNode[] @relation("Solver")    // ปัญหาที่ user นี้แก้สำเร็จ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// PILLAR 5: DOMAIN DIRECTOR (ผู้อำนวยการวงการ — พาร์ทเนอร์ระดับชาติ)
// ============================================================

model DomainDirector {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  industryId String   @unique
  industry   Industry @relation(fields: [industryId], references: [id])

  displayName String // ชื่อ Co-branding
  title       String // ตำแหน่ง เช่น "ผู้เชี่ยวชาญระดับประเทศ"
  bio         String?
  avatarUrl   String?
  bannerUrl   String? // ภาพ Hero Banner

  // ผลประโยชน์ — ส่วนแบ่งจาก Platform Fee (basis points: 2000 = 20.00%)
  profitSharePercentage Int @default(2000)
  equityPoints          Int @default(0) // คะแนนหุ้นส่วนสะสม
  totalEarnedSatang     Int @default(0) // รายได้สะสม (สตางค์)

  // Relations
  endorsements       Endorsement[]
  disputeResolutions EscrowVault[] @relation("DisputeResolver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PROJECT SYSTEM
// ============================================================

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  industryId  String
  industry    Industry @relation(fields: [industryId], references: [id])
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])

  status       String @default("DRAFT") // DRAFT, SIMULATION, HOT_MISSION, ACTIVE, COMPLETED, CANCELLED
  budgetSatang Int    @default(0) // งบประมาณรวม (สตางค์)

  // Project Blueprint — แผนภาพรวมโปรเจกต์ (JSON)
  // e.g. {"vision": "...", "milestones": [...], "roles": [...], "successMetrics": "..."}
  projectBlueprint String? // JSON String

  // Rosetta Stone: อ้างอิง IdeaDot Code ที่เป็นแม่แบบของโปรเจกต์นี้
  // e.g. "DOT003" = ใช้ Template การจับคู่แบบ DOT003
  blueprintDotCode String? // Logical FK → IdeaDot.code

  // Location สำหรับ Heat Map
  province  String?
  district  String?
  latitude  Float?
  longitude Float?

  // Director endorsement
  isEndorsed Boolean @default(false)

  // Relations
  members      ProjectMember[]
  canvas       CollaborationCanvas?
  escrow       EscrowVault?
  guarantor    GuarantorNode?
  endorsements Endorsement[]
  simulations  ProjectSimulation[]
  equitySplit  EquitySplit?        // ระบบแบ่งสัดส่วน equity ของโปรเจกต์นี้
  escrowNew    Escrow?             // Phase 1 Escrow ล็อกเงิน/ทรัพยากร

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  role String @default("MEMBER") // OWNER, MEMBER, CONTRACTOR, INVESTOR

  // ส่วนแบ่ง (basis points: 5000 = 50.00%)
  equityPercentage Int @default(0)

  status   String    @default("INVITED") // INVITED, ACCEPTED, REJECTED
  joinedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// ============================================================
// PILLAR 2: COLLABORATION CANVAS (แคนวาสข้อตกลงร่วม)
// ============================================================

model CollaborationCanvas {
  id         String  @id @default(cuid())
  projectId  String  @unique
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposerId String
  proposer   User    @relation("CanvasProposer", fields: [proposerId], references: [id])

  splitType String @default("REVENUE_SHARE") // REVENUE_SHARE, FLAT_FEE, HYBRID

  // Breakeven Logic
  hasBreakeven          Boolean @default(false)
  breakevenAmountSatang Int     @default(0)
  breakevenRecipientId  String?

  status String @default("DRAFT") // DRAFT, PROPOSED, COUNTERED, AGREED, SIGNED

  smartSummary String? // ข้อตกลงฉบับย่อ (ภาษาคนอ่านง่าย)
  signedAt     DateTime?

  // Relations
  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id       String              @id @default(cuid())
  canvasId String
  canvas   CollaborationCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  contributorId         String // User ID ของคนที่ลงทรัพยากร
  label                 String // เช่น "ห้องอัดเสียง 3 วัน"
  icon                  String? // FontAwesome icon
  category              String // EQUIPMENT, LABOR, CASH, VENUE, IP
  equivalentValueSatang Int // มูลค่าเทียบเท่า (สตางค์)

  createdAt DateTime @default(now())
}

// ============================================================
// PILLAR 3: ESCROW VAULT (ตู้เซฟคนกลาง)
// ============================================================

model EscrowVault {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  totalAmountSatang Int @default(0) // ยอดเงินรวมในตู้เซฟ
  releasedSatang    Int @default(0) // ยอดที่ปลดล็อกแล้ว
  frozenSatang      Int @default(0) // ยอดที่แช่แข็ง (พิพาท)

  paymentMethod   String  @default("BANK_TRANSFER") // STRIPE_CONNECT, CRYPTO_WALLET, BANK_TRANSFER
  stripePaymentId String?
  cryptoTxHash    String?
  bankSlipUrl     String?

  status String @default("PENDING") // PENDING, LOCKED, PARTIALLY_RELEASED, FULLY_RELEASED, DISPUTED, REFUNDED

  // Dispute Resolution
  disputeReason    String?
  disputedAt       DateTime?
  resolvedById     String?
  resolvedDirector DomainDirector? @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?

  // Fee Breakdown (สตางค์)
  platformFeeSatang Int @default(0)
  directorFeeSatang Int @default(0)

  // Relations
  milestones Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id       String      @id @default(cuid())
  escrowId String
  escrow   EscrowVault @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  title        String // เช่น "งวดที่ 1: ส่งเดโม"
  description  String?
  amountSatang Int // จำนวนเงินในงวดนี้ (สตางค์)
  order        Int     @default(0)

  status String @default("LOCKED") // LOCKED, PENDING_REVIEW, APPROVED, RELEASED, DISPUTED

  approvedById String?
  approvedAt   DateTime?
  releasedAt   DateTime?

  createdAt DateTime @default(now())
}

// ============================================================
// PILLAR 4: GUARANTOR SYSTEM (ผู้ค้ำประกัน)
// ============================================================

model GuarantorNode {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  guarantorType String @default("PEER") // PEER, INSTITUTIONAL, COLLATERAL_ASSET

  // Peer Guarantor
  guarantorUserId String?
  guarantorUser   User?   @relation("GuarantorUser", fields: [guarantorUserId], references: [id])

  // Institutional
  institutionName    String?
  institutionLicense String?

  // Collateral
  collateralDescription  String?
  collateralAmountSatang Int     @default(0) // มูลค่าค้ำ (สตางค์)

  // ค่าธรรมเนียมความเสี่ยง (basis points: 300 = 3.00%)
  premiumFeePercentage Int @default(300)

  status String @default("PENDING") // PENDING, ACTIVE, CLAIMED, EXPIRED

  approvedAt DateTime?
  claimedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ENDORSEMENT (ตราประทับจาก Director)
// ============================================================

model Endorsement {
  id         String         @id @default(cuid())
  directorId String
  director   DomainDirector @relation(fields: [directorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?    @relation("EndorsedUser", fields: [userId], references: [id])

  message    String?
  isFeatured Boolean @default(false) // ขึ้นหน้าแนะนำระดับประเทศ

  createdAt DateTime @default(now())
}

// ============================================================
// SYSTEM CONFIGURATION
// ============================================================

model SystemConfig {
  id String @id @default("GLOBAL")

  // AI Settings
  aiEnabled      Boolean @default(true)
  autoFallback   Boolean @default(true)
  primaryModel   String  @default("models/gemini-3.8-flash")
  fallbackModels String  @default("models/gemini-3.7-flash,models/deep-research-preview-04-2026") // Comma separated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PROJECT SIMULATOR
// ============================================================
model ProjectSimulation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scenarioType String // "BEST_CASE", "EXPECTED", "WORST_CASE"

  // Financial Outcomes
  projectedRevenueSatang Int     @default(0)
  escrowStatus           String // e.g., "FULLY_RELEASED", "DISPUTED", "REFUNDED"
  guarantorClaimed       Boolean @default(false)

  // Summary
  impactSummary String?

  createdAt DateTime @default(now())
}

// ============================================================
// IDEA & CONCEPT SCRATCHPAD — THE ROSETTA STONE
// ============================================================
model IdeaDot {
  id          String   @id @default(cuid())
  code        String   @unique // "DOT001", "DOT002" ... — Logical Primary Key ทั้งระบบ
  title       String
  description String
  status      String   @default("DRAFT") // DRAFT, IMPLEMENTED, ARCHIVED

  // Technical Bridge — JSON แปลงวิสัยทัศน์ → Program Logic
  // {"linkedModel": "QuestionFlow", "linkedId": "xxx", "apiEndpoint": "/api/flow", "triggerCondition": "..."}
  technicalBridge String? // JSON String

  // Hierarchy: รองรับ Folder / Sub-folder ไม่จำกัดชั้น
  parentId String?
  parent   IdeaDot?  @relation("DotHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children IdeaDot[] @relation("DotHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PHASE 1: QUESTION FLOW ENGINE — Dynamic Q&A (Quantum Match)
// ============================================================

model QuestionFlow {
  id          String  @id @default(cuid())
  industryId  String? // null = Global flow (ข้ามทุกวงการ)

  title       String  // ชื่อชุดคำถาม เช่น "ค้นหาพาร์ทเนอร์ดนตรี"
  description String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  // Rosetta Stone: Dot ที่เป็นต้นกำเนิดของ Flow นี้
  originDotCode String? // Logical FK → IdeaDot.code

  // Self-referencing: Flow นี้เกิดจากการ Branch มาจาก Flow อื่นหรือไม่
  parentFlowId String?
  parentFlow   QuestionFlow?  @relation("FlowBranching", fields: [parentFlowId], references: [id])
  childFlows   QuestionFlow[] @relation("FlowBranching")

  options FlowOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FlowOption {
  id     String       @id @default(cuid())
  flowId String
  flow   QuestionFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  label String  // ข้อความตัวเลือก เช่น "ฉันต้องการทรัพยากร"
  icon  String? // FontAwesome icon
  order Int     @default(0)

  // Rosetta Stone: Option นี้ Trigger ตรรกะของ DOT ไหน
  // เช่น "DOT002" = เลือกแล้วให้ไปใช้ตรรกะทรัพยากรของ DOT002
  relatedDotCode String?

  // Vector weight สำหรับ Algorithm คำนวณคะแนน
  vectorWeight String? // JSON: {"budget": 10, "sweat": -5, "timeline": 3}

  // Branching: เลือก Option นี้แล้วจะ Branch ไป Flow ถัดไป (null = จบ แสดงผลลัพธ์)
  nextFlowId String?

  createdAt DateTime @default(now())
}

// ============================================================
// PHASE 1: EQUITY SPLIT — ระบบแบ่งสัดส่วน (Rosetta Stone: DOT001)
// ============================================================

model EquitySplit {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  splitType String @default("EQUAL") // EQUAL, CUSTOM, CONTRIBUTION_BASED, HYBRID

  // Rosetta Stone: ใช้ Template การแบ่งจาก DOT ไหน
  templateDotCode String? // Logical FK → IdeaDot.code (เช่น "DOT001" = สัดส่วนตามบทบาท)

  // สถานะรวมของการตกลง
  status   String    @default("NEGOTIATING") // NEGOTIATING, PROPOSED, ALL_AGREED, LOCKED
  agreedAt DateTime?
  lockedAt DateTime?

  // สมาชิกที่มีส่วนแบ่งใน Split นี้
  members EquitySplitMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Junction Table: User ↔ EquitySplit (แต่ละคนได้กี่ % และบทบาทอะไร)
model EquitySplitMember {
  id            String      @id @default(cuid())
  equitySplitId String
  equitySplit   EquitySplit @relation(fields: [equitySplitId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  // บทบาทของ User ใน Project นี้ (อ้างอิง DOT001: Creator, Executor, Guarantor, Investor)
  role String @default("MEMBER") // OWNER, CREATOR, EXECUTOR, GUARANTOR, INVESTOR, ADVISOR

  // สัดส่วน basis points: 5000 = 50.00%
  percentage Int @default(0)

  // สถานะการยอมรับของ User คนนี้
  status     String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTER_PROPOSED
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([equitySplitId, userId])
}

// ============================================================
// PHASE 1: ESCROW — ล็อกเงิน/ทรัพยากร ผูกกับ Project
// ============================================================

model Escrow {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // ประเภทสิ่งที่ล็อก
  escrowType String @default("CASH") // CASH, RESOURCE, IP, MIXED

  // มูลค่าที่ล็อก (สตางค์)
  totalAmountSatang   Int @default(0)
  releasedSatang      Int @default(0)
  remainingSatang     Int @default(0)

  // สถานะ
  status String @default("PENDING") // PENDING, LOCKED, PARTIALLY_RELEASED, FULLY_RELEASED, DISPUTED, REFUNDED

  // Rosetta Stone: อ้างอิง DOT ที่กำหนดเงื่อนไขการปล่อยเงิน
  conditionDotCode String? // Logical FK → IdeaDot.code

  // หลักฐานการชำระ
  paymentRef  String? // Bank slip URL, Tx Hash, หรือ Stripe ID
  disputedAt  DateTime?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PHASE 1: AGENT LOG — Evolution Memory (DOT005: 3-Layer AI)
// ============================================================

model AgentLog {
  id String @id @default(cuid())

  // ประเภทการตัดสินใจของ AI
  action       String // CODE_EDIT, DB_PUSH, GIT_COMMIT, SCHEMA_UPDATE, FLOW_CREATED, MATCH_EXECUTED, EQUITY_PROPOSED
  decisionType String @default("EXECUTION") // PLANNING, EXECUTION, REVIEW, LEARNING

  // Rosetta Stone: การตัดสินใจนี้เกี่ยวข้องกับ DOT ไหน
  // ทำให้ AI รุ่นถัดไปย้อนรอยได้ว่า "สร้าง Flow นี้เพราะวิสัยทัศน์ DOT005"
  relatedDotCode String? // Logical FK → IdeaDot.code

  // รายละเอียด
  details String? // อธิบายว่า AI ตัดสินใจทำอะไร และเพราะอะไร
  payload String? // JSON — ข้อมูลเพิ่มเติม (diff, matched users, proposed equity, etc.)

  // สถานะ
  status   String  @default("SUCCESS") // SUCCESS, FAILED, PENDING, ROLLED_BACK
  errorMsg String?

  // Performance
  durationMs    Int?
  affectedFiles String? // JSON array: ["src/app/page.tsx"]

  createdAt DateTime @default(now())
}

// ============================================================
// PHASE 1.5: UNIVERSAL PROBLEM MATRIX — Occupation & Skill Taxonomy
// ============================================================

// Occupation: อาชีพ/บทบาท ที่อยู่ใต้ Industry
// Industry → Occupation (One-to-Many)
model Occupation {
  id         String   @id @default(cuid())
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  name        String  // เช่น "Sound Engineer", "โปรดิวเซอร์", "Session Musician"
  description String?
  icon        String? // FontAwesome icon
  order       Int     @default(0)

  // Rosetta Stone
  relatedDotCode String? // Logical FK → IdeaDot.code

  // Relations
  skillTags    SkillTag[]    // Occupation → SkillTag (One-to-Many)
  problemNodes ProblemNode[] // ปัญหาในระบบที่ต้องการอาชีพนี้

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SkillTag: ทักษะเฉพาะ ที่อยู่ใต้ Occupation
// Occupation → SkillTag (One-to-Many)
model SkillTag {
  id           String     @id @default(cuid())
  occupationId String
  occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  name  String  // เช่น "Pro Tools", "ทักษะกีตาร์คลาสสิก", "React.js"
  level String  @default("ANY") // ANY, BEGINNER, INTERMEDIATE, EXPERT, MASTER
  icon  String?

  // Relations (M:N กับ ProblemNode ผ่าน Junction)
  problemSkills ProblemSkillTag[]

  createdAt DateTime @default(now())
}

// ============================================================
// PHASE 1.5: PROBLEM NODE — The Quest / Bounty Core (DOT012)
// ============================================================

// ProblemNode คือ "Quest" หนึ่งใบ ที่มีเงินรางวัลแขวนอยู่
// Requester ตั้ง → ระบบล็อกเงินใน Escrow → Solver รับงาน → ตกลง KPI → ปลดล็อกเงิน
model ProblemNode {
  id String @id @default(cuid())

  // ===== THE QUEST DESCRIPTION =====
  rawDescription String  // คำอธิบายปัญหาแบบดิบ จาก User พิมพ์เอง
  entityType     String  // ประเภทหน่วยงาน: INDIVIDUAL, STARTUP, SME, ENTERPRISE, NGO
  primaryGap     String  // ช่องว่างหลัก: SKILL_GAP, RESOURCE_GAP, NETWORK_GAP, CAPITAL_GAP, KNOWLEDGE_GAP
  urgencyState   String  @default("NORMAL") // NORMAL, URGENT, CRITICAL, HOT_MISSION

  // Deep Attributes — AI วิเคราะห์และเติม (JSON)
  // {"estimatedDays": 7, "requiredHeadcount": 2, "locationRequired": "กรุงเทพ", "remoteOk": true, "kpiDraft": "..."}
  deepAttributes String? // JSON String

  // ===== BOUNTY PROTOCOL (DOT012) =====
  bountyPrizeSatang Int     @default(0) // เงินรางวัลค่าหัว (สตางค์) — ถ้า 0 = แลกเปลี่ยน/ไม่ใช่เงินสด
  bountyType        String  @default("CASH") // CASH, EQUITY, RESOURCE_SWAP, HYBRID
  bountyDescription String? // อธิบายรางวัลเพิ่มเติม (เช่น "ฟรีค่าห้องอัดเสียง 3 วัน")

  // ===== KPI & NEGOTIATION SANDBOX =====
  kpiDefinition  String? // JSON: [{"metric": "ยอดขาย", "target": "100 units", "deadline": "2026-12-31"}]
  kpiAgreedAt    DateTime? // ทั้งสองฝ่ายตกลง KPI แล้ว
  negotiationLog String?   // JSON array: บันทึกประวัติการต่อรอง

  // ===== STATUS & LIFECYCLE =====
  // OPEN → MATCHING (AI กำลังหา Solver) → NEGOTIATING → ACTIVE → PENDING_REVIEW → COMPLETED | CANCELLED | DISPUTED
  status String @default("OPEN")

  // ===== ROSETTA STONE =====
  originDotCode String? // Logical FK → IdeaDot.code (เช่น "DOT012" = Bounty Protocol)

  // ===== OCCUPATION TAXONOMY =====
  occupationId String?
  occupation   Occupation? @relation(fields: [occupationId], references: [id])

  // ===== RELATIONS: Engine Connection =====
  // Requester: คนตั้งปัญหา (เจ้าของค่าหัว)
  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  // Solver: คนรับงาน (นักล่าค่าหัว)
  solverId String?
  solver   User?   @relation("Solver", fields: [solverId], references: [id])

  // Skills ที่ต้องการ (M:N)
  requiredSkills ProblemSkillTag[]

  // Escrow: เงินที่ล็อกไว้ (1:1 — บังคับล็อกทันทีที่ตั้งค่าหัว)
  escrowId String?  @unique
  // NOTE: ไม่ผูก Relation ตรงเพราะใช้ Escrow model เดิมที่ผูกกับ Project
  // ในอนาคตเมื่อ Bounty ใหญ่ขึ้นจะแยก BountyEscrow ออกมา

  // Timestamps
  publishedAt  DateTime? // เวลาที่เปิดรับสมัคร
  matchedAt    DateTime? // เวลาที่ AI จับคู่สำเร็จ
  startedAt    DateTime? // เวลาเริ่มงานจริง
  completedAt  DateTime? // เวลาที่งานสำเร็จ
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Junction Table: ProblemNode ↔ SkillTag (M:N)
// "Quest นี้ต้องการ SkillTag เหล่านี้"
model ProblemSkillTag {
  id            String      @id @default(cuid())
  problemNodeId String
  problemNode   ProblemNode @relation(fields: [problemNodeId], references: [id], onDelete: Cascade)
  skillTagId    String
  skillTag      SkillTag    @relation(fields: [skillTagId], references: [id])

  isRequired Boolean @default(true) // true = บังคับ, false = มีแล้วได้เปรียบ

  @@unique([problemNodeId, skillTagId])
}

